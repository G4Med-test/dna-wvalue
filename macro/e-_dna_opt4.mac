# w value of electrons, 12 eV to 10 keV, in liquid water with Geant4-DNA dna_opt4.
# Validation macro, run unchanged by the CI (no /control/execute, loops or
# aliases). One /run/beamOn per energy: Run::EndOfRun appends one line per
# run to wvalue.txt, read by validation/parser.py.
/control/verbose 2
/run/verbose 1
/run/numberOfThreads 4
/random/setSeeds 12345 67890
#
/w/det/setMat G4_WATER
/w/det/setRadius 1 m
/w/det/setTrackingCut 9 eV
/w/phys/addPhysics dna_opt4
#
/run/initialize
/run/printProgress 0
#
/gun/particle e-
#
/gun/energy 12 eV
/run/beamOn 1000
#
/gun/energy 15 eV
/run/beamOn 1000
#
/gun/energy 20 eV
/run/beamOn 1000
#
/gun/energy 30 eV
/run/beamOn 1000
#
/gun/energy 40 eV
/run/beamOn 1000
#
/gun/energy 50 eV
/run/beamOn 1000
#
/gun/energy 60 eV
/run/beamOn 1000
#
/gun/energy 70 eV
/run/beamOn 1000
#
/gun/energy 80 eV
/run/beamOn 1000
#
/gun/energy 90 eV
/run/beamOn 1000
#
/gun/energy 100 eV
/run/beamOn 1000
#
/gun/energy 200 eV
/run/beamOn 1000
#
/gun/energy 300 eV
/run/beamOn 1000
#
/gun/energy 400 eV
/run/beamOn 1000
#
/gun/energy 500 eV
/run/beamOn 1000
#
/gun/energy 600 eV
/run/beamOn 1000
#
